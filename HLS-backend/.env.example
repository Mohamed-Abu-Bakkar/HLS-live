# Neon connection strings — refresh with `neon env pull` (branch: production)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# Neon Object Storage (hotels bucket) — pulled by `neon deploy` / `neon env pull`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_STORAGE_BUCKET=hotel-images

# Local Postgres fallback — only used when DATABASE_URL is unset
DB_HOST=localhost
DB_PORT=5435
DB_USER=hotel_user
DB_PASSWORD=password
DB_NAME=hotel_db

PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:3000
